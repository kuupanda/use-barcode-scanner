{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"noEmit": true,
		"isolatedModules": true,
		"resolveJsonModule": true
	},
	"include": ["src", "tests"]
}
